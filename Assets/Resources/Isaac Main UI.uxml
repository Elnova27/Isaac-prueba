<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Screen" style="background-size: 100% 100%; background-color: rgba(255, 0, 0, 0); width: 1920px; -unity-background-scale-mode: stretch-to-fill; background-position-y: top 0; background-position-x: left 0; flex-direction: row; height: 1080px; align-items: center; justify-content: center; align-self: center;">
        <ui:VisualElement name="HealthBar" style="width: 772px; background-color: rgba(255, 0, 0, 0.45); position: absolute; top: 62px; left: 172px; right: auto; bottom: auto; height: 446px;">
            <ui:VisualElement name="FullHeart" style="flex-grow: 1; background-image: resource(&quot;Imagenes/Interfaz/Corazones&quot;); -unity-slice-type: sliced;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
